{
  "name": "Hair Salon - Daily privacy clean-up",
  "flow": [
    {
      "id": 1,
      "module": "datastore:SearchRecords",
      "version": 1,
      "parameters": {
        "datastore": 166708
      },
      "mapper": {
        "limit": 1000
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "All customer records"
        }
      }
    },
    {
      "id": 2,
      "module": "datastore:DeleteRecord",
      "version": 1,
      "parameters": {
        "datastore": 166708
      },
      "mapper": {
        "key": "{{1.key}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Delete old record"
        }
      },
      "filter": {
        "name": "Older than 30 days",
        "conditions": [
          [
            {
              "a": "{{addDays(parseDate(ifempty(1.last_seen; \"2000-01-01 00:00\"); \"YYYY-MM-DD HH:mm\"; \"Africa/Johannesburg\"); 30)}}",
              "o": "date:less",
              "b": "{{now}}"
            },
            {
              "a": "{{1.date}}",
              "o": "notexist"
            }
          ],
          [
            {
              "a": "{{addDays(parseDate(ifempty(1.last_seen; \"2000-01-01 00:00\"); \"YYYY-MM-DD HH:mm\"; \"Africa/Johannesburg\"); 30)}}",
              "o": "date:less",
              "b": "{{now}}"
            },
            {
              "a": "{{addDays(parseDate(1.date; \"YYYY-MM-DD\"; \"Africa/Johannesburg\"); 30)}}",
              "o": "date:less",
              "b": "{{now}}"
            }
          ]
        ]
      },
      "onerror": [
        {
          "id": 3,
          "module": "builtin:Ignore",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 300,
              "y": 250
            }
          }
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 10,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com",
    "notes": []
  }
}